# Environment variables for PythonAnywhere production

# --- JWT Authentication (REQUIRED for production) ---
# Generate a random 32+ character string, or use this default (change it!):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=gurutze-fantasy-prod-secret-cambiar-en-produccion-2024

# --- CORS ---
# Allow requests from the Vercel frontend
CORS_ORIGINS=https://gfweb-one.vercel.app,https://gfweb.vercel.app,http://localhost:3000

# --- Disable background loops (use on-demand endpoints instead) ---
GURUTZE_DISABLE_AUTO_CLOSE=1
GURUTZE_DISABLE_SOFA_UPDATE=1
GURUTZE_NIGHTLY_DISABLE=1

# --- Optional: Gmail configuration for password reset ---
# GURUTZE_EMAIL_MODE=dev
# GURUTZE_GMAIL_USER=your-email@gmail.com
# GURUTZE_GMAIL_APP_PASSWORD=your-app-password
# GURUTZE_FRONTEND_URL=https://gfweb-one.vercel.app