# Variables de entorno para el proyecto Fantasy App

# --- Base de datos ---
# Si está definida, el backend usará PostgreSQL.
# Si no está definida, usará SQLite automaticamente.
DATABASE_URL=

# --- JWT Authentication ---
JWT_SECRET=changed-this-in-production-minimum-32-chars

# --- API-Football (opcional, para futuras funcionalidades) ---
API_FOOTBALL_KEY=

# --- CORS ---
# Orígenes permitidos separados por comas.
# Ej: http://localhost:3000,https://gfweb-one.vercel.app
CORS_ORIGINS=http://localhost:3000,https://gfweb-one.vercel.app

# --- Backend URL (usado por el frontend) ---
# URL donde corre el backend FastAPI.
# El frontend NEXT_PUBLIC_API_URL tomará esta por defecto.
BACKEND_URL=http://localhost:8000

# --- Configuración SofaScore ---
PAUSA_SEGUNDOS=8.0